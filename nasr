package com.cib.impalaStressTester;

import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import com.zaxxer.hikari.HikariPoolMXBean;

import javax.security.auth.login.LoginContext;
import javax.security.auth.login.LoginException;

import java.io.File;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

public class ImpalaService {

    private final HikariDataSource readDataSource;
    private final HikariDataSource writeDataSource;

    private static final String DATABASE =
            "DEV_CNSMR_LO";

    private static final String KRB_REALM =
            "HODOMAIN.LOCAL";

    private static final String KRB_PRINCIPAL =
            "moba42876@HODOMAIN.LOCAL";

    private static final String KRB5_CONFIG =
            "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/securityConfigs/kerb5.ini";

    private static final String JAAS_CONFIG =
            "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/securityConfigs/moba42876_kafka_client_jaas.conf";

    private static final String KEYTAB_FILE =
            "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/securityConfigs/moba42876.keytab";

    private static final String TRUSTSTORE_FILE =
            "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/cm-auto-global_truststore.jks";

    private static final String TRUSTSTORE_PASSWORD =
            "CDPEIMPASS";

    private final int workerNodeId;
    private final String host;
    private final String jdbcUrl;

    public ImpalaService(int workerNodeId) {

        /*
         * Production workers:
         *
         * 1 -> cdp-p-wrkr1.hodomain.local
         * 2 -> cdp-p-wrkr2.hodomain.local
         * 3 -> cdp-p-wrkr3.hodomain.local
         */
        if (workerNodeId < 1 || workerNodeId > 3) {

            throw new IllegalArgumentException(
                    "Invalid workerNodeId: " +
                    workerNodeId +
                    ". Allowed values are 1, 2, or 3."
            );
        }

        this.workerNodeId =
                workerNodeId;

        this.host =
                "cdp-p-wrkr" +
                workerNodeId +
                ".hodomain.local";

        /*
         * -------------------------------------------------
         * Kerberos / JAAS JVM configuration
         * -------------------------------------------------
         */
        System.setProperty(
                "java.security.krb5.conf",
                KRB5_CONFIG
        );

        System.setProperty(
                "java.security.auth.login.config",
                JAAS_CONFIG
        );

        System.setProperty(
                "javax.security.auth.useSubjectCredsOnly",
                "false"
        );

        /*
         * Enable while troubleshooting.
         * Set to false/remove later if logs become too noisy.
         */
        System.setProperty(
                "sun.security.krb5.debug",
                "true"
        );

        /*
         * -------------------------------------------------
         * Validate local security files
         * -------------------------------------------------
         */
        printKerberosConfiguration();

        validateSecurityFiles();

        /*
         * -------------------------------------------------
         * Test JAAS login BEFORE creating Hikari pools.
         *
         * This separates:
         *
         * keytab / JAAS / KDC problems
         *
         * from:
         *
         * JDBC / Impala / TLS problems
         * -------------------------------------------------
         */
        testKerberosLogin();

        /*
         * -------------------------------------------------
         * Production Impala JDBC URL
         *
         * KrbAuthType=1 means JAAS performs the login.
         *
         * Principal and keytab therefore come from
         * the Client block in the JAAS file.
         * -------------------------------------------------
         */
        this.jdbcUrl =
                "jdbc:impala://" +
                host +
                ":21050/" +
                DATABASE +

                ";AuthMech=1" +

                ";KrbAuthType=1" +

                ";KrbRealm=" +
                KRB_REALM +

                ";KrbHostFQDN=" +
                host +

                ";KrbServiceName=impala" +

                ";SSL=1" +

                ";SSLTrustStore=" +
                TRUSTSTORE_FILE +

                ";SSLTrustStorePwd=" +
                TRUSTSTORE_PASSWORD +

                ";UseNativeQuery=1;";

        System.out.println();
        System.out.println(
                "========================================"
        );
        System.out.println(
                "PRODUCTION IMPALA STRESS TEST"
        );
        System.out.println(
                "Worker ID : " +
                workerNodeId
        );
        System.out.println(
                "Host      : " +
                host
        );
        System.out.println(
                "Database  : " +
                DATABASE
        );
        System.out.println(
                "Principal : " +
                KRB_PRINCIPAL
        );
        System.out.println(
                "JDBC URL  : " +
                jdbcUrl
        );
        System.out.println(
                "========================================"
        );

        /*
         * -------------------------------------------------
         * READ connection pool
         * -------------------------------------------------
         */
        HikariConfig readConfig =
                createBaseConfig();

        readConfig.setPoolName(
                "HikariPool-Read-wrkr" +
                workerNodeId
        );

        /*
         * Keep your existing value.
         *
         * For the first production test you may want
         * to temporarily reduce this to 5-10.
         */
        readConfig.setMaximumPoolSize(
                50
        );

        readConfig.setConnectionTimeout(
                10000
        );

        this.readDataSource =
                new HikariDataSource(
                        readConfig
                );

        /*
         * -------------------------------------------------
         * WRITE connection pool
         * -------------------------------------------------
         */
        HikariConfig writeConfig =
                createBaseConfig();

        writeConfig.setPoolName(
                "HikariPool-Write-wrkr" +
                workerNodeId
        );

        /*
         * Keep your existing value.
         *
         * For the first production test you may want
         * to temporarily reduce this to 1-2.
         */
        writeConfig.setMaximumPoolSize(
                14
        );

        writeConfig.setConnectionTimeout(
                10000
        );

        this.writeDataSource =
                new HikariDataSource(
                        writeConfig
                );
    }

    /*
     * -------------------------------------------------
     * Hikari base configuration
     * -------------------------------------------------
     */
    private HikariConfig createBaseConfig() {

        HikariConfig config =
                new HikariConfig();

        config.setDriverClassName(
                "com.cloudera.impala.jdbc41.Driver"
        );

        config.setJdbcUrl(
                jdbcUrl
        );

        config.setConnectionTimeout(
                10000
        );

        config.setValidationTimeout(
                5000
        );

        config.setConnectionTestQuery(
                "SELECT 1"
        );

        return config;
    }

    /*
     * -------------------------------------------------
     * Kerberos configuration diagnostics
     * -------------------------------------------------
     */
    private void printKerberosConfiguration() {

        System.out.println(
                "========================================"
        );

        System.out.println(
                "KERBEROS CONFIGURATION"
        );

        System.out.println(
                "krb5.conf = " +
                System.getProperty(
                        "java.security.krb5.conf"
                )
        );

        System.out.println(
                "JAAS      = " +
                System.getProperty(
                        "java.security.auth.login.config"
                )
        );

        System.out.println(
                "Principal = " +
                KRB_PRINCIPAL
        );

        System.out.println(
                "Keytab    = " +
                KEYTAB_FILE
        );

        System.out.println(
                "========================================"
        );
    }

    /*
     * -------------------------------------------------
     * Validate local files before attempting Kerberos.
     * -------------------------------------------------
     */
    private void validateSecurityFiles() {

        File krb5File =
                new File(
                        KRB5_CONFIG
                );

        File jaasFile =
                new File(
                        JAAS_CONFIG
                );

        File keytabFile =
                new File(
                        KEYTAB_FILE
                );

        File truststoreFile =
                new File(
                        TRUSTSTORE_FILE
                );

        System.out.println(
                "krb5 exists       = " +
                krb5File.exists()
        );

        System.out.println(
                "JAAS exists       = " +
                jaasFile.exists()
        );

        System.out.println(
                "Keytab exists     = " +
                keytabFile.exists()
        );

        System.out.println(
                "Truststore exists = " +
                truststoreFile.exists()
        );

        if (!krb5File.exists()) {

            throw new IllegalStateException(
                    "Kerberos configuration file not found: " +
                    KRB5_CONFIG
            );
        }

        if (!jaasFile.exists()) {

            throw new IllegalStateException(
                    "JAAS configuration file not found: " +
                    JAAS_CONFIG
            );
        }

        if (!keytabFile.exists()) {

            throw new IllegalStateException(
                    "Kerberos keytab not found: " +
                    KEYTAB_FILE
            );
        }

        if (!truststoreFile.exists()) {

            throw new IllegalStateException(
                    "SSL truststore not found: " +
                    TRUSTSTORE_FILE
            );
        }
    }

    /*
     * -------------------------------------------------
     * Explicit JAAS Kerberos test
     * -------------------------------------------------
     */
    private void testKerberosLogin() {

        System.out.println();
        System.out.println(
                "Testing JAAS Client Kerberos login..."
        );

        try {

            LoginContext loginContext =
                    new LoginContext(
                            "Client"
                    );

            loginContext.login();

            System.out.println(
                    "JAAS Kerberos login SUCCESS"
            );

            System.out.println(
                    "Authenticated subject = " +
                    loginContext.getSubject()
            );

        } catch (LoginException e) {

            System.err.println(
                    "JAAS Kerberos login FAILED"
            );

            e.printStackTrace();

            throw new IllegalStateException(
                    "Kerberos JAAS login failed for principal " +
                    KRB_PRINCIPAL,
                    e
            );
        }
    }

    /*
     * -------------------------------------------------
     * READ stress query
     * -------------------------------------------------
     */
    public int executeQuery(String rowKey)
            throws SQLException {

        int rowCount =
                0;

        String sql =
                "SELECT shortname, country, postcode " +
                "FROM dev_cnsmr_lo.customer_keys " +
                "WHERE row_key = ?";

        try (
                Connection conn =
                        readDataSource
                                .getConnection();

                PreparedStatement stmt =
                        conn.prepareStatement(
                                sql
                        )
        ) {

            stmt.setString(
                    1,
                    rowKey
            );

            try (
                    ResultSet result =
                            stmt.executeQuery()
            ) {

                while (
                        result.next()
                ) {

                    rowCount++;
                }
            }
        }

        return rowCount;
    }

    /*
     * -------------------------------------------------
     * WRITE stress query
     *
     * Performs:
     *
     * 1. SELECT
     * 2. INSERT
     *
     * against the production customer_keys table.
     * -------------------------------------------------
     */
    public int executeInsert(String rowKey)
            throws SQLException {

        String readSql =
                "SELECT shortname, country, postcode " +
                "FROM dev_cnsmr_lo.customer_keys " +
                "WHERE row_key = ?";

        String writeSql =
                "INSERT INTO dev_cnsmr_lo.customer_keys " +
                "(row_key, country, postcode) " +
                "VALUES (?, 'qw_EG', 'qw_11511')";

        try (
                Connection conn =
                        writeDataSource
                                .getConnection();

                PreparedStatement readStmt =
                        conn.prepareStatement(
                                readSql
                        );

                PreparedStatement writeStmt =
                        conn.prepareStatement(
                                writeSql
                        )
        ) {

            /*
             * Execute READ first
             */
            readStmt.setString(
                    1,
                    rowKey
            );

            try (
                    ResultSet result =
                            readStmt.executeQuery()
            ) {

                /*
                 * Consume result set.
                 *
                 * This ensures the read is actually completed.
                 */
                while (
                        result.next()
                ) {
                    // No processing required.
                }
            }

            /*
             * Execute WRITE
             */
            writeStmt.setString(
                    1,
                    rowKey
            );

            return writeStmt
                    .executeUpdate();
        }
    }

    /*
     * -------------------------------------------------
     * Hikari pool metrics
     * -------------------------------------------------
     */
    public void printPoolStatus() {

        HikariPoolMXBean readBean =
                readDataSource
                        .getHikariPoolMXBean();

        if (readBean != null) {

            System.out.printf(
                    "[Worker %d][%s] " +
                    "Total: %d | " +
                    "Active: %d | " +
                    "Idle: %d | " +
                    "Waiting: %d%n",

                    workerNodeId,

                    readDataSource
                            .getPoolName(),

                    readBean
                            .getTotalConnections(),

                    readBean
                            .getActiveConnections(),

                    readBean
                            .getIdleConnections(),

                    readBean
                            .getThreadsAwaitingConnection()
            );
        }

        HikariPoolMXBean writeBean =
                writeDataSource
                        .getHikariPoolMXBean();

        if (writeBean != null) {

            System.out.printf(
                    "[Worker %d][%s] " +
                    "Total: %d | " +
                    "Active: %d | " +
                    "Idle: %d | " +
                    "Waiting: %d%n",

                    workerNodeId,

                    writeDataSource
                            .getPoolName(),

                    writeBean
                            .getTotalConnections(),

                    writeBean
                            .getActiveConnections(),

                    writeBean
                            .getIdleConnections(),

                    writeBean
                            .getThreadsAwaitingConnection()
            );
        }
    }

    public String getHost() {

        return host;
    }

    public int getWorkerNodeId() {

        return workerNodeId;
    }

    /*
     * -------------------------------------------------
     * Close pools cleanly
     * -------------------------------------------------
     */
    public void closeDataSource() {

        if (
                readDataSource != null &&
                !readDataSource.isClosed()
        ) {

            readDataSource.close();
        }

        if (
                writeDataSource != null &&
                !writeDataSource.isClosed()
        ) {

            writeDataSource.close();
        }
    }
}
