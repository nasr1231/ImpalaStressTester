package com.cib.impalaStressTester;

import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import java.sql.*;
import com.zaxxer.hikari.HikariPoolMXBean;

public class ImpalaService {

    private final HikariDataSource readDataSource;
    private final HikariDataSource writeDataSource;

    public ImpalaService(int workerNodeId) {

        System.setProperty("java.security.krb5.conf", "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/securityConfigs/kerb5.ini");
        System.setProperty("java.security.auth.login.config", "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/securityConfigs/moba42876_kafka_client_jaas.conf");
        System.setProperty("javax.security.auth.useSubjectCredsOnly", "false");

        String jdbcUrl = "jdbc:impala://cdp-p-wrkr" + workerNodeId + ".hodomain.local:21050/DEV_CNSMR_LO;UseNativeQuery=1;";

        // READ Connection Pool
        HikariConfig readConfig = createBaseConfig(jdbcUrl, workerNodeId);
        readConfig.setPoolName("HikariPool-Read-wrkr" + workerNodeId);
        readConfig.setMaximumPoolSize(50);
        readConfig.setConnectionTimeout(10000);
        this.readDataSource = new HikariDataSource(readConfig);

        // WRITE Connection Pool
        HikariConfig writeConfig = createBaseConfig(jdbcUrl, workerNodeId);
        writeConfig.setPoolName("HikariPool-Write-wrkr" + workerNodeId);
        writeConfig.setMaximumPoolSize(14);
        writeConfig.setConnectionTimeout(10000);
        this.writeDataSource = new HikariDataSource(writeConfig);
    }

    private HikariConfig createBaseConfig(String jdbcUrl, int nodeId) {
        HikariConfig config = new HikariConfig();
        config.setJdbcUrl(jdbcUrl);
        config.addDataSourceProperty("AuthMech", "1");
        config.addDataSourceProperty("KrbAuthType", "1");
        config.addDataSourceProperty("KrbHostFQDN", "cdp-p-wrkr" + nodeId + ".hodomain.local");
        config.addDataSourceProperty("KrbServiceName", "impala");
        config.addDataSourceProperty("KrbRealm", "HODOMAIN.LOCAL");
        config.addDataSourceProperty("KrbKeytabFile", "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/securityConfigs/moba42876.keytab");
        config.addDataSourceProperty("KrbPrincipal", "omab42697@HODOMAIN.LOCAL");
        config.addDataSourceProperty("SSL", "1");
        config.addDataSourceProperty("SSLTrustStore", "C:/Users/MOBA42876/Documents/ImpalaStressTester_wrkr2/cm-auto-global_truststore.jks");
        config.addDataSourceProperty("SSLTrustStorePwd", "CDPEIMPASS");
        config.setDriverClassName("com.cloudera.impala.jdbc41.Driver");
        return config;
    }


    public void printPoolStatus() {
        // 1. Fetch Read Pool Metrics
        HikariPoolMXBean readBean = readDataSource.getHikariPoolMXBean();
        if (readBean != null) {
            System.out.printf("[%s] Total: %d | Active: %d | Idle: %d | Threads Waiting: %d%n",
                    readDataSource.getPoolName(),
                    readDataSource.getHikariConfigMXBean().getMaximumPoolSize(),
                    readBean.getActiveConnections(),
                    readBean.getIdleConnections(),
                    readBean.getThreadsAwaitingConnection()
            );
        }

        // 2. Fetch Write Pool Metrics
        HikariPoolMXBean writeBean = writeDataSource.getHikariPoolMXBean();
        if (writeBean != null) {
            System.out.printf("[%s] Total: %d | Active: %d | Idle: %d | Threads Waiting: %d%n",
                    writeDataSource.getPoolName(),
                    writeDataSource.getHikariConfigMXBean().getMaximumPoolSize(),
                    writeBean.getActiveConnections(),
                    writeBean.getIdleConnections(),
                    writeBean.getThreadsAwaitingConnection()
            );
        }
    }

    public int executeQuery(String rowKey) throws SQLException {
        int rowCount = 0;
        String sql = "SELECT shortname, country, postcode FROM dev_cnsmr_lo.customer_keys WHERE row_key='" + rowKey + "'";

        try (Connection conn = readDataSource.getConnection();
             Statement stmt = conn.createStatement();
             ResultSet res = stmt.executeQuery(sql)) {
            while (res.next()) {
                rowCount++;
            }
        }
        return rowCount;
    }


    public int executeInsert(String rowKey) throws SQLException {
        try (Connection conn = writeDataSource.getConnection();
             PreparedStatement r = conn.prepareStatement("SELECT shortname , country, postcode FROM dev_cnsmr_lo.customer_keys WHERE row_key=?");
             PreparedStatement w = conn.prepareStatement("INSERT INTO dev_cnsmr_lo.customer_keys (row_key, country, postcode) VALUES (?, 'qw_EG', 'qw_11511')")) {

            r.setString(1, rowKey);
            r.executeQuery().close();

            w.setString(1, rowKey);
            w.executeUpdate();
            return 1;
        }
    }

    public void closeDataSource() {
        if (readDataSource != null) readDataSource.close();
        if (writeDataSource != null) writeDataSource.close();
    }
}
