def nullable_capture(col):
    trimmed = F.trim(col)

    unquoted = F.regexp_replace(
        trimmed,
        r'^"(.*)"$',
        r'$1',
    )

    unquoted = F.regexp_replace(
        unquoted,
        '""',
        '"',
    )

    return F.when(
        unquoted.isNull() | (unquoted == ""),
        F.lit(None).cast("string"),
    ).otherwise(unquoted)


